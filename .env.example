# Copy to .env and fill in as real providers/connectors are wired up.
# Nothing here is required to run the local mock-provider dev slice.

PORT=8787
DATABASE_URL=postgres://axora:axora_dev_password@localhost:5432/axora
AXORA_SQLITE_PATH=./dev.sqlite   # used only when DATABASE_URL is unset

# Max size of a single request body (bytes) before the gateway rejects
# it with 413. Default 50MB — generous for base64-encoded document/image
# uploads while still bounding per-request memory use.
# AXORA_MAX_BODY_BYTES=52428800

# Rate limiting (per client IP, token bucket). Defaults: burst up to 20
# requests, refilling at 1/second (60/minute sustained). /v1/health is
# always exempt regardless of these settings.
# AXORA_RATE_LIMIT_CAPACITY=20
# AXORA_RATE_LIMIT_PER_SECOND=1

# Model providers — leave unset to use the built-in offline MockProvider.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Secret vault encryption key (32 bytes, base64, AES-256-GCM) — required
# to enable POST/GET/DELETE /v1/vault/secrets; without it those
# endpoints return 503 and the rest of the gateway is unaffected. Never
# commit a real value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AXORA_SECRET_KEY=

# AXORA Core integration (docs/CORE_PROTOCOL.md) — path to a compiled
# `axora-core` binary (`cargo build --release` in services/core). Leave
# unset to use the gateway's built-in local TypeScript PolicyEngine,
# which is functionally equivalent and fully verified; the Core
# subprocess path exists for when the Rust implementation becomes
# authoritative. If set but the binary can't be started, the gateway
# falls back to the local provider and logs why — it never silently
# pretends Core is active.
# AXORA_CORE_BIN=./services/core/target/release/axora-core
